# =====================================================================
# Dulank Admin — Contoh Konfigurasi Lingkungan
# Salin ke `.env` dan sesuaikan. Jangan commit `.env` (sudah di-.gitignore).
# =====================================================================

# --- API Backend Laravel ---------------------------------------------
#
# Base URL API Laravel yang dipakai `apiFetch` (client + SSR).
# - KOSONGKAN  → permintaan same-origin (lewat proxy Nitro, lihat LARAVEL_API_URL).
# - DIISI      → permintaan langsung ke Laravel, contoh dev:
#
#   NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000
#
NUXT_PUBLIC_API_BASE=

# URL Laravel untuk routeRules proxy `/api/v1/**` — dipakai saat
# NUXT_PUBLIC_API_BASE kosong (mode same-origin tanpa CORS).
LARAVEL_API_URL=http://127.0.0.1:8000

# --- Server Dev Nuxt -------------------------------------------------
# Port dev server (default Nuxt: 3000).
PORT=3000